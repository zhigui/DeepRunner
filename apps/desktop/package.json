    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "ai.deeprunner.desktop",
    "productName": "DeepRunner",
    "asar": true,
    "asarUnpack": [
      "package.json",
      "lib/**",
      "node_modules/**"
    ],
    "afterPack": "./scripts/verify-packaged-runtime.mjs",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "zhigui",
      "repo": "DeepRunner",
      "releaseType": "release"
    },
    "files": [
      "lib/**",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/@deeprunner/*/src/**",
      "!node_modules/@deeprunner/*/tests/**",
      "!node_modules/@deeprunner/*/tsconfig*.json",
      "!node_modules/@deeprunner/*/tsdown.config.*"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../upstream.json",
        "to": "legal/upstream.json"
      }
    ],
    "mac": {
      "icon": "build/DeepRunner.icon",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "DeepRunner plugin links",
        "schemes": [
          "deeprunner"
        ]
      }
    ]
  }
}
